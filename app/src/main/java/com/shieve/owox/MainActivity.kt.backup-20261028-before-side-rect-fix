/** Ролик, найденный под пальцем: прямой адрес (если есть), id твита и токен embed-API. */
private data class VideoProbe(val src: String, val tweetId: String, val token: String)

private data class DownloadTask(
    val url: String,
    val fileName: String,
    val mimeType: String,
    /** Если задан, прямой адрес видео сначала нужно получить через embed-API X. */
    val probe: VideoProbe? = null
)

private class FileChooserHolder {
    var callback: ValueCallback<Array<Uri>>? = null
}

private class PendingDownloadHolder {
    var task: DownloadTask? = null
}

private val ioExecutor = Executors.newCachedThreadPool()

private fun toastOnMain(context: Context, text: String) {
    mainHandler.post { Toast.makeText(context, text, Toast.LENGTH_SHORT).show() }
}

private fun openConnection(url: String): HttpURLConnection =
    (URL(url).openConnection() as HttpURLConnection).apply {
        connectTimeout = 15_000
        readTimeout = 30_000
        setRequestProperty("User-Agent", CHROME_UA)
        setRequestProperty("Referer", "https://x.com/")
    }

/** Для картинок твитов (pbs.twimg.com/media) запрашиваем оригинальный размер. */
private fun originalImageUrl(url: String): String {
    val uri = Uri.parse(url)
    if (uri.host != "pbs.twimg.com" || uri.path?.startsWith("/media/") != true) return url
    val builder = uri.buildUpon().clearQuery()
    uri.queryParameterNames
        .filter { it != "name" }
        .forEach { builder.appendQueryParameter(it, uri.getQueryParameter(it)) }
    builder.appendQueryParameter("name", "orig")
    return builder.build().toString()
}

private fun imageDownloadTask(rawUrl: String): DownloadTask {
    val url = originalImageUrl(rawUrl)
    val uri = Uri.parse(url)
    val ext = uri.getQueryParameter("format")
        ?: uri.lastPathSegment?.substringAfterLast('.', "")?.takeIf { it.length in 3..4 }
        ?: "jpg"
    val mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext.lowercase()) ?: "image/jpeg"
    return DownloadTask(url, "owox_${System.currentTimeMillis()}.$ext", mime)
}

/** GIF в X на самом деле mp4-ролики из tweet_video: сохраняются как короткое зацикленное видео. */
private fun isGifProbe(probe: VideoProbe): Boolean = probe.src.contains("tweet_video")

private fun videoDownloadTask(probe: VideoProbe): DownloadTask {
    val name = "owox_${System.currentTimeMillis()}.mp4"
    val isDirect = probe.src.startsWith("http", ignoreCase = true) && probe.src.contains(".mp4")
    // blob:-адреса плеера скачать нельзя, поэтому для них прямая ссылка ищется через твит
    return if (isDirect) {
        DownloadTask(probe.src, name, "video/mp4")
    } else {
        DownloadTask(probe.src, name, "video/mp4", probe)
    }
}

/** Разбор ответа скрипта mediaProbeScript (evaluateJavascript возвращает JSON-строку в кавычках). */
private fun parseVideoProbe(raw: String?): VideoProbe? {
    if (raw.isNullOrBlank() || raw == "null") return null
    return try {
        val text = JSONTokener(raw).nextValue() as? String ?: return null
        if (text.isEmpty()) return null
        val json = JSONObject(text)
        VideoProbe(json.optString("src"), json.optString("id"), json.optString("token"))
    } catch (_: Exception) {
        null
    }
}

private fun resolutionScore(url: String): Int {
    val match = Regex("""/(\d+)x(\d+)/""").find(url) ?: return 0
    return match.groupValues[1].toInt() * match.groupValues[2].toInt()
}

/** Из списка вариантов выбирает mp4 лучшего качества (по битрейту, а без него по разрешению в адресе). */
private fun pickBestMp4(variants: JSONArray?, typeKey: String, urlKey: String): String? {
    if (variants == null) return null
    var best: String? = null
    var bestScore = -1L
    for (i in 0 until variants.length()) {
        val variant = variants.optJSONObject(i) ?: continue
        if (variant.optString(typeKey) != "video/mp4") continue
        val url = variant.optString(urlKey)
        if (url.isBlank()) continue
        val bitrate = variant.optInt("bitrate", 0)
        val score = if (bitrate > 0) bitrate.toLong() else resolutionScore(url).toLong()
        if (score > bestScore) {
            bestScore = score
            best = url
        }
    }
    return best
}

private fun findMp4(tweet: JSONObject): String? {
    val media = tweet.optJSONArray("mediaDetails")
    if (media != null) {
        for (i in 0 until media.length()) {
            val variants = media.optJSONObject(i)?.optJSONObject("video_info")?.optJSONArray("variants")
            pickBestMp4(variants, "content_type", "url")?.let { return it }
        }
    }
    return pickBestMp4(tweet.optJSONObject("video")?.optJSONArray("variants"), "type", "src")
}

/** Получает прямую mp4-ссылку через публичный embed-API X. Выполняется в фоновом потоке. */
private fun resolveVideoUrl(probe: VideoProbe): String {
    if (probe.tweetId.isBlank()) throw IOException("не удалось определить твит с видео")
    val endpoint = "https://cdn.syndication.twimg.com/tweet-result?id=${probe.tweetId}&token=${probe.token}"
    val connection = openConnection(endpoint)
    try {
        if (connection.responseCode !in 200..299) throw IOException("X не отдал данные твита (${connection.responseCode})")
        val body = connection.inputStream.bufferedReader().use { it.readText() }
        val json = JSONObject(body)
        return findMp4(json)
            ?: json.optJSONObject("quoted_tweet")?.let { findMp4(it) }
            ?: throw IOException("в твите не найдено видео")
    } finally {
        connection.disconnect()
    }
}

/**
 * Картинки и видео сохраняются сами (не через DownloadManager), чтобы они гарантированно
 * появлялись в галерее. Остальные файлы уходят в системную папку «Загрузки».
 */
private fun enqueueDownload(context: Context, task: DownloadTask) {
    val appContext = context.applicationContext
    val isMedia = task.probe != null || task.mimeType.startsWith("image/") || task.mimeType.startsWith("video/")
    if (isMedia) {
        toastOnMain(appContext, "Сохраняю…")
        ioExecutor.execute {
            try {
                val resolved = task.probe?.let { task.copy(url = resolveVideoUrl(it), probe = null) } ?: task
                val location = saveMediaToGallery(appContext, resolved)
                toastOnMain(appContext, "Сохранено в $location")
            } catch (e: Exception) {
                toastOnMain(appContext, "Не удалось сохранить: ${e.message ?: "ошибка сети"}")
            }
        }
    } else {
        enqueueWithDownloadManager(appContext, task)
    }
}

private fun enqueueWithDownloadManager(context: Context, task: DownloadTask) {
    try {
        val request = DownloadManager.Request(Uri.parse(task.url))
            .setMimeType(task.mimeType)
            .addRequestHeader("User-Agent", CHROME_UA)
            .setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
            .setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, "OwOX/${task.fileName}")
        CookieManager.getInstance().getCookie(task.url)?.let { request.addRequestHeader("Cookie", it) }
        context.getSystemService(DownloadManager::class.java).enqueue(request)
        toastOnMain(context, "Загрузка началась")
    } catch (_: Exception) {
        toastOnMain(context, "Не удалось начать загрузку")
    }
}

/** Скачивает файл и кладёт его в Pictures/OwOX или Movies/OwOX. Выполняется в фоновом потоке. */
private fun saveMediaToGallery(context: Context, task: DownloadTask): String {
    val connection = openConnection(task.url)
    CookieManager.getInstance().getCookie(task.url)?.let { connection.setRequestProperty("Cookie", it) }
    try {
        if (connection.responseCode !in 200..299) throw IOException("сервер ответил ${connection.responseCode}")

        val responseMime = connection.contentType?.substringBefore(';')?.trim()?.lowercase()
        val mime = responseMime?.takeIf { it.startsWith("image/") || it.startsWith("video/") } ?: task.mimeType
        val isVideo = mime.startsWith("video/")
        val extension = (MimeTypeMap.getSingleton().getExtensionFromMimeType(mime)
            ?: task.fileName.substringAfterLast('.', "jpg"))
            .let { if (it == "jpeg") "jpg" else it }
        val fileName = task.fileName.substringBeforeLast('.') + "." + extension
        val directory = if (isVideo) Environment.DIRECTORY_MOVIES else Environment.DIRECTORY_PICTURES

        connection.inputStream.use { input ->
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                saveViaMediaStore(context, input, directory, fileName, mime, isVideo)
            } else {
                saveToLegacyStorage(context, input, directory, fileName, mime)
            }
        }
        return "$directory/OwOX"
    } finally {
        connection.disconnect()
    }
}

/** Android 10+: запись через MediaStore, разрешения не нужны, файл сразу виден в галерее. */
@androidx.annotation.RequiresApi(Build.VERSION_CODES.Q)
private fun saveViaMediaStore(
    context: Context,
    input: InputStream,
    directory: String,
    fileName: String,
    mime: String,
    isVideo: Boolean
) {
    val resolver = context.contentResolver
    val collection = if (isVideo) {
        MediaStore.Video.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
    } else {
        MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY)
    }
    val values = ContentValues().apply {
        put(MediaStore.MediaColumns.DISPLAY_NAME, fileName)
        put(MediaStore.MediaColumns.MIME_TYPE, mime)
        put(MediaStore.MediaColumns.RELATIVE_PATH, "$directory/OwOX")
        put(MediaStore.MediaColumns.IS_PENDING, 1)
    }
    val uri = resolver.insert(collection, values) ?: throw IOException("хранилище недоступно")
    try {
        val output = resolver.openOutputStream(uri) ?: throw IOException("не удалось открыть файл")
        output.use { input.copyTo(it) }
        values.clear()
        values.put(MediaStore.MediaColumns.IS_PENDING, 0)
        resolver.update(uri, values, null, null)
    } catch (e: Exception) {
        resolver.delete(uri, null, null)
        throw e
    }
}

/** Android 9 и ниже: обычный файл + явное сканирование, чтобы галерея его увидела. */
@Suppress("DEPRECATION")
private fun saveToLegacyStorage(
    context: Context,
    input: InputStream,
    directory: String,
    fileName: String,
    mime: String
) {
    val dir = File(Environment.getExternalStoragePublicDirectory(directory), "OwOX")
    if (!dir.exists() && !dir.mkdirs()) throw IOException("не удалось создать папку")
    val file = File(dir, fileName)
    file.outputStream().use { input.copyTo(it) }
    MediaScannerConnection.scanFile(context, arrayOf(file.absolutePath), arrayOf(mime), null)
}

/** Запрос на сохранение медиа: подпись кнопки и действие. Показывается M3-панелью (см. [SaveMediaSheet]). */
private data class SaveRequest(val label: String, val onSave: () -> Unit)

/**
 * Нижняя панель M3 (ModalBottomSheet) с одной главной кнопкой, в стиле остального клиента:
 * цвета берутся из MaterialTheme, поэтому панель следует за темой и выбранным акцентом.
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
private fun SaveMediaSheet(request: SaveRequest, onDismiss: () -> Unit) {
    val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
    val scope = rememberCoroutineScope()

    // Сначала плавно убираем панель, и только потом убираем её из композиции
    fun closeThen(action: () -> Unit) {
        scope.launch { sheetState.hide() }.invokeOnCompletion {
            onDismiss()
            action()
        }
    }

    ModalBottomSheet(
        onDismissRequest = onDismiss,
        sheetState = sheetState,
        containerColor = MaterialTheme.colorScheme.surfaceContainerLow
    ) {
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 24.dp)
                .padding(bottom = 24.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            FilledTonalButton(
                onClick = { closeThen(request.onSave) },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(52.dp)
            ) {
                Text(request.label, style = MaterialTheme.typography.labelLarge)
            }
            TextButton(
                onClick = { closeThen { } },
                modifier = Modifier.fillMaxWidth()
            ) {
                Text("Отмена")
            }
        }
    }
}

// ───────────────────────────── Акцент внутри X ─────────────────────────────

private fun loadRecentAccents(prefs: android.content.SharedPreferences): List<Int> =
    prefs.getString(PREF_RECENT_ACCENTS, null)
        ?.split(',')
        ?.mapNotNull { it.trim().toIntOrNull() }
        ?.distinct()
        ?.take(RECENT_ACCENTS_MAX)
        ?: emptyList()

/**
 * Перекрашивает акцентные цвета X (см. [ACCENT_SOURCES]: голубой, фиолетовый, розовый цвет лайка)
 * в выбранный цвет.
 *
 * X хранит цвет в двух местах: в правилах таблиц стилей (классы вида r-xxxx) и в inline-стилях элементов.
 * Скрипт заменяет цвет и там и там по значению, а не по именам классов, которые меняются от сборки к сборке:
 *  - обходит все доступные таблицы стилей и переписывает совпавшие объявления;
 *  - подменяет insertRule, чтобы правила, которые X добавляет позже, сразу получали нужный цвет;
 *  - наблюдает за новыми элементами и стилями и перекрашивает их с задержкой (не чаще раза в 300 мс).
 * Повторный вызов с другим цветом заменяет предыдущий. Цвет по умолчанию («как в X») возвращает
 * исходные цвета страницы: после правок их не восстановить по значению, поэтому страница перезагружается.
 */
private fun accentScript(argb: Int): String {
    val r = (argb shr 16) and 0xFF
    val g = (argb shr 8) and 0xFF
    val b = argb and 0xFF
    val isDefault = (argb and 0xFFFFFF) == (DEFAULT_ACCENT.toArgb() and 0xFFFFFF)
    val cssHex = String.format(Locale.ROOT, "#%02X%02X%02X", r, g, b)
    val sources = ACCENT_SOURCES.joinToString(",") { "'$it'" }
    return """
        (function () {
            var host = location.hostname;
            var isX = host === 'x.com' || host === 'twitter.com' ||
                host.endsWith('.x.com') || host.endsWith('.twitter.com');
            if (!isX) return;

            var SOURCES = [$sources];
            var next = '$r, $g, $b';
            var reset = $isDefault;

            // Цвет контейнера для меню совпадает с выбранным акцентом приложения.
            document.documentElement.style.setProperty('--owox-accent', '$cssHex');

            var st = window.__owoxAccent;
            if (!st) {
                st = window.__owoxAccent = { cur: null, patched: false, observing: false, dirty: false, timer: 0 };
            }

            if (reset) {
                // Исходные цвета страницы уже затёрты: единственный способ их вернуть, это перезагрузка
                if (st.cur) { st.cur = null; location.reload(); }
                return;
            }

            // Одно регулярное выражение на все цвета из списка: «r,\s*g,\s*b|r,\s*g,\s*b|…»
            function reFor(list) {
                return new RegExp(list.map(function (triplet) {
                    return triplet.split(',').map(function (s) { return s.trim(); }).join(',\\s*');
                }).join('|'), 'g');
            }
            var SOURCES_RE = reFor(SOURCES);

            function swapRule(rule, re, to) {
                if (rule.cssRules) {
                    for (var i = 0; i < rule.cssRules.length; i++) swapRule(rule.cssRules[i], re, to);
                }
                var style = rule.style;
                if (!style) return;
                re.lastIndex = 0;
                if (!re.test(style.cssText)) return;
                for (var j = 0; j < style.length; j++) {
                    var prop = style[j];
                    var value = style.getPropertyValue(prop);
                    re.lastIndex = 0;
                    if (re.test(value)) {
                        style.setProperty(prop, value.replace(re, to), style.getPropertyPriority(prop));
                    }
                }
            }

            function swapSheets(from, to) {
                var re = reFor(from);
                var sheets = document.styleSheets;
                for (var i = 0; i < sheets.length; i++) {
                    var rules;
                    try { rules = sheets[i].cssRules; } catch (e) { continue; } // чужой домен без CORS
                    if (!rules) continue;
                    for (var j = 0; j < rules.length; j++) {
                        try { swapRule(rules[j], re, to); } catch (e) {}
                    }
                }
            }

            function swapInline(from, to) {
                var re = reFor(from);
                var selectors = [];
                from.forEach(function (triplet) {
                    selectors.push('[style*="' + triplet + '"]');
                    selectors.push('[style*="' + triplet.replace(/, /g, ',') + '"]');
                });
                var els = document.querySelectorAll(selectors.join(','));
                for (var i = 0; i < els.length; i++) {
                    var attr = els[i].getAttribute('style');
                    if (!attr) continue;
                    var fixed = attr.replace(re, to);
                    if (fixed !== attr) els[i].setAttribute('style', fixed);
                }
            }

            // Правила, которые X добавляет уже после нас, получают выбранный цвет сразу
            if (!st.patched) {
                st.patched = true;
                var originalInsert = CSSStyleSheet.prototype.insertRule;
                CSSStyleSheet.prototype.insertRule = function (rule, index) {
                    if (st.cur && typeof rule === 'string') rule = rule.replace(SOURCES_RE, st.cur);
                    return originalInsert.call(this, rule, index);
                };
            }

            function schedule() {
                if (st.timer) return;
                st.timer = setTimeout(function () {
                    st.timer = 0;
                    if (!st.cur) return;
                    if (st.dirty) { st.dirty = false; swapSheets(SOURCES, st.cur); }
                    swapInline(SOURCES, st.cur);
                }, 300);
            }

            if (!st.observing) {
                st.observing = true;
                new MutationObserver(function (records) {
                    for (var i = 0; i < records.length; i++) {
                        var added = records[i].addedNodes;
                        for (var j = 0; added && j < added.length; j++) {
                            var tag = added[j].tagName;
                            if (tag === 'STYLE' || tag === 'LINK') st.dirty = true;
                        }
                    }
                    schedule();
                }).observe(document.documentElement, {
                    childList: true, subtree: true, attributes: true, attributeFilter: ['style']
                });
            }

            // Что перекрашивать: исходные цвета X и, если акцент уже менялся, прошлый выбранный цвет
            var prev = st.cur;
            st.cur = next;
            var from = (prev && prev !== next) ? [prev].concat(SOURCES) : SOURCES;
            swapSheets(from, next);
            swapInline(from, next);
            st.dirty = true; // новые таблицы стилей могли появиться с прошлого вызова
            schedule();
        })();
    """.trimIndent()
}

