/** Переход внутри SPA кликом по ссылке; если ссылки нет в DOM, обычная загрузка страницы. */
private fun WebView.openPath(path: String) {
    evaluateJavascript(
        """
        (function () {
            var link = document.querySelector('a[href="$path"]');
            if (link) link.click(); else location.href = 'https://x.com$path';
        })();
        """.trimIndent(),
        null
    )
}

private fun hostIn(host: String?, domains: List<String>): Boolean {
    val h = host?.lowercase() ?: return false
    return domains.any { h == it || h.endsWith(".$it") }
}

/** Индекс вкладки нижней панели для адреса страницы X или null, если страница не относится ни к одной. */
private fun tabForUrl(url: String?): Int? {
    val uri = Uri.parse(url ?: return null)
    if (!hostIn(uri.host, X_DOMAINS)) return null
    val path = uri.path.orEmpty().trimEnd('/')
    return when {
        path == "/home" -> 0
        path == "/explore" || path.startsWith("/explore/") || path == "/search" -> 1
        path == "/notifications" || path.startsWith("/notifications/") -> TAB_NOTIFICATIONS
        path == "/messages" || path.startsWith("/messages/") || path.startsWith("/i/chat") -> TAB_MESSAGES
        else -> null
    }
}

private fun isInternalUri(uri: Uri): Boolean {
    val host = uri.host?.lowercase()
    return hostIn(host, INTERNAL_DOMAINS) || host?.startsWith("accounts.google.") == true
}

private fun openExternally(context: Context, uri: Uri) {
    try {
        context.startActivity(Intent(Intent.ACTION_VIEW, uri))
    } catch (_: Exception) {
        // нет приложения, способного открыть ссылку
    }
}

private val mainHandler = Handler(Looper.getMainLooper())

/**
 * Мост для JS: страница передаёт сюда число непрочитанных уведомлений и сообщений
 * (-1 означает «не менять»). Вызовы приходят из служебного потока, поэтому
 * результат переносится в главный.
 */
class OwOXBridge(private val listener: (notifications: Int, messages: Int) -> Unit) {
    @JavascriptInterface
    fun onBadges(notifications: Int, messages: Int) {
        mainHandler.post { listener(notifications, messages) }
    }
}

