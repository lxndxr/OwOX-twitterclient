}

/** Бейдж с числом непрочитанного; M3-вид один и тот же для уведомлений и сообщений. */
@Composable
private fun NavBadge(count: Int) {
    if (count > 0) {
        Badge {
            Text(if (count > 99) "99+" else count.toString())
        }
    }
}

/** Вынесен отдельно, чтобы тики прогресса перерисовывали только эту полоску, а не весь экран. */
@Composable
private fun LoadProgressBar(progress: () -> Int, visible: Boolean) {
    val value = progress()
    if (visible && value in 1..99) {
        LinearProgressIndicator(
            progress = { value / 100f },
            modifier = Modifier
                .fillMaxWidth()
                .height(2.dp),
            color = MaterialTheme.colorScheme.primary,
            trackColor = Color.Transparent
        )
    }
}

// ───────────────────────────── Настройки ─────────────────────────────

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun OwOXSettingsScreen(
    currentTheme: AppThemeMode,
    onSelectTheme: (AppThemeMode) -> Unit,
    accent: Color,
    onAccentChange: (Color) -> Unit,
    recentAccents: List<Color>,
    onAccentPick: (Color) -> Unit,
    textScale: Int,
    onTextScaleChange: (Int) -> Unit,
    fontName: String?,
    onPickFont: () -> Unit,
    onResetFont: () -> Unit
) {
    val colors = MaterialTheme.colorScheme
    val scrollBehavior = TopAppBarDefaults.pinnedScrollBehavior()

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(colors.background)
            .nestedScroll(scrollBehavior.nestedScrollConnection)
    ) {
        // Компактный закреплённый заголовок M3: прижат к верху экрана, без пустого места над текстом
        TopAppBar(
            title = { Text("Настройки OwOX", style = MaterialTheme.typography.headlineSmall) },
            colors = TopAppBarDefaults.topAppBarColors(
                containerColor = colors.background,
                scrolledContainerColor = colors.surfaceContainer
            ),
            scrollBehavior = scrollBehavior
        )

        Column(
            modifier = Modifier
                .weight(1f)
                .fillMaxWidth()
                .verticalScroll(rememberScrollState())
                .padding(start = 16.dp, end = 16.dp, bottom = 24.dp)
        ) {
            Text(
                text = "Кастомизация клиента и синхронизация с X",
                style = MaterialTheme.typography.bodyMedium,
                color = colors.onSurfaceVariant,
                modifier = Modifier.padding(horizontal = 16.dp)
            )

            Spacer(modifier = Modifier.height(24.dp))

            Text(
                text = "Тема оформления",
                style = MaterialTheme.typography.labelLarge,
                color = colors.primary,
                modifier = Modifier.padding(start = 16.dp, bottom = 8.dp)
            )

            // Сегментированный список: крупные скругления снаружи, мелкие между пунктами
            val lastIndex = AppThemeMode.entries.lastIndex
            Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
                AppThemeMode.entries.forEachIndexed { index, mode ->
                    val outer = 24.dp
                    val inner = 4.dp
                    val shape = RoundedCornerShape(
                        topStart = if (index == 0) outer else inner,
                        topEnd = if (index == 0) outer else inner,
                        bottomStart = if (index == lastIndex) outer else inner,
                        bottomEnd = if (index == lastIndex) outer else inner
                    )
                    ThemeOptionItem(
                        mode = mode,
                        selected = currentTheme == mode,
                        shape = shape,
                        onClick = { if (currentTheme != mode) onSelectTheme(mode) }
                    )
                }
            }

            Spacer(modifier = Modifier.height(24.dp))

            Text(
                text = "Цвет акцента",
                style = MaterialTheme.typography.labelLarge,
                color = colors.primary,
                modifier = Modifier.padding(start = 16.dp, bottom = 8.dp)
            )
            AccentColorCard(
                accent = accent,
                recent = recentAccents,
                onAccentChange = onAccentChange,
                onAccentPick = onAccentPick
            )

            Spacer(modifier = Modifier.height(24.dp))

            Text(
                text = "Текст и шрифт",
                style = MaterialTheme.typography.labelLarge,
                color = colors.primary,
                modifier = Modifier.padding(start = 16.dp, bottom = 8.dp)
            )
            TextAppearanceCard(
                textScale = textScale,
                onTextScaleChange = onTextScaleChange,
                fontName = fontName,
                onPickFont = onPickFont,
                onResetFont = onResetFont
            )
        }
    }
}

@Composable
private fun ThemeOptionItem(
    mode: AppThemeMode,
    selected: Boolean,
    shape: Shape,
    onClick: () -> Unit
) {
    ListItem(
        headlineContent = { Text(mode.title) },
        supportingContent = { Text(mode.subtitle) },
        leadingContent = { ThemeSwatch(mode) },
        // Нажатие обрабатывает вся строка (selectable), у самой кнопки клик отключён
        trailingContent = { RadioButton(selected = selected, onClick = null) },
        colors = ListItemDefaults.colors(containerColor = Color.Transparent),
        modifier = Modifier
            .fillMaxWidth()
            .clip(shape)
            .background(MaterialTheme.colorScheme.surfaceContainerHigh)
            .selectable(selected = selected, role = Role.RadioButton, onClick = onClick)
    )
}

/** Кружок-превью темы: её фон и точка текущего акцентного цвета. */
@Composable
private fun ThemeSwatch(mode: AppThemeMode) {
    Box(
        modifier = Modifier
            .size(40.dp)
            .clip(CircleShape)
            .background(mode.bgColor)
            .border(1.dp, MaterialTheme.colorScheme.outlineVariant, CircleShape),
        contentAlignment = Alignment.Center
    ) {
        Box(
            modifier = Modifier
                .size(14.dp)
                .clip(CircleShape)
                .background(MaterialTheme.colorScheme.primary)
        )
    }
}

/** Выбор акцентного цвета: готовые цвета X и RGB-палитра на трёх слайдерах. */
@Composable
private fun AccentColorCard(
    accent: Color,
    recent: List<Color>,
    onAccentChange: (Color) -> Unit,
    onAccentPick: (Color) -> Unit
) {
    val colors = MaterialTheme.colorScheme
    val argb = accent.toArgb()
    val r = (argb shr 16) and 0xFF
    val g = (argb shr 8) and 0xFF
    val b = argb and 0xFF

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(24.dp))
            .background(colors.surfaceContainerHigh)
            .padding(16.dp)
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Box(
                modifier = Modifier
                    .size(48.dp)
                    .clip(CircleShape)
                    .background(accent)
                    .border(1.dp, colors.outlineVariant, CircleShape)
            )
            Spacer(modifier = Modifier.width(16.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = String.format(Locale.ROOT, "#%02X%02X%02X", r, g, b),
                    style = MaterialTheme.typography.titleMedium,
                    color = colors.onSurface
                )
                Text(
                    text = "RGB $r, $g, $b",
                    style = MaterialTheme.typography.bodySmall,
                    color = colors.onSurfaceVariant
                )
            }
            TextButton(
                onClick = { onAccentPick(DEFAULT_ACCENT) },
                enabled = argb != DEFAULT_ACCENT.toArgb()
            ) {
                Text("Сбросить")
            }
        }

        Spacer(modifier = Modifier.height(16.dp))

        Text(
            text = "Недавние",
            style = MaterialTheme.typography.labelMedium,
            color = colors.onSurfaceVariant
        )
        Spacer(modifier = Modifier.height(8.dp))
        if (recent.isEmpty()) {
            Text(
                text = "Здесь появятся цвета, на которых вы останавливались.",
                style = MaterialTheme.typography.bodySmall,
                color = colors.onSurfaceVariant
            )
        } else {
            Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                recent.forEach { color ->
                    AccentPresetDot(
                        color = color,
                        selected = color.toArgb() == argb,
                        onClick = { onAccentPick(color) }
                    )
                }
            }
        }

        Spacer(modifier = Modifier.height(8.dp))

        ChannelSlider(label = "R", value = r, tint = Color(0xFFE53935)) { onAccentChange(Color(it, g, b)) }
        ChannelSlider(label = "G", value = g, tint = Color(0xFF43A047)) { onAccentChange(Color(r, it, b)) }
        ChannelSlider(label = "B", value = b, tint = Color(0xFF1E88E5)) { onAccentChange(Color(r, g, it)) }
    }
}

@Composable
private fun AccentPresetDot(color: Color, selected: Boolean, onClick: () -> Unit) {
    val onColor = if (color.luminance() > 0.45f) Color.Black else Color.White
    Box(
        modifier = Modifier
            .size(36.dp)
            .clip(CircleShape)
            .background(color)
            .selectable(selected = selected, role = Role.RadioButton, onClick = onClick),
        contentAlignment = Alignment.Center
    ) {
        if (selected) {
            Icon(
                imageVector = Icons.Filled.Check,
                contentDescription = null,
                tint = onColor,
                modifier = Modifier.size(20.dp)
            )
        }
    }
}

@Composable
private fun ChannelSlider(label: String, value: Int, tint: Color, onValueChange: (Int) -> Unit) {
    val colors = MaterialTheme.colorScheme
    Row(verticalAlignment = Alignment.CenterVertically) {
        Text(
            text = label,
            style = MaterialTheme.typography.labelLarge,
            color = colors.onSurfaceVariant,
            modifier = Modifier.width(20.dp)
        )
        Slider(
            value = value.toFloat(),
            onValueChange = { onValueChange(it.roundToInt()) },
            valueRange = 0f..255f,
            modifier = Modifier.weight(1f),
            colors = SliderDefaults.colors(
                thumbColor = tint,
                activeTrackColor = tint,
                inactiveTrackColor = tint.copy(alpha = 0.24f)
            )
        )
        Text(
            text = value.toString(),
            style = MaterialTheme.typography.bodyMedium,
            color = colors.onSurface,
            textAlign = TextAlign.End,
            modifier = Modifier.width(36.dp)
        )
    }
}

/** Размер текста в X и выбор своего шрифта из файла. Предпросмотр рисуется текущим шрифтом приложения. */
@Composable
private fun TextAppearanceCard(
    textScale: Int,
    onTextScaleChange: (Int) -> Unit,
    fontName: String?,
    onPickFont: () -> Unit,
    onResetFont: () -> Unit
) {
    val colors = MaterialTheme.colorScheme

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(24.dp))
            .background(colors.surfaceContainerHigh)
            .padding(16.dp)
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = "Размер текста в X",
                    style = MaterialTheme.typography.titleMedium,
                    color = colors.onSurface
                )
                Text(
                    text = "$textScale%",
                    style = MaterialTheme.typography.bodySmall,
                    color = colors.onSurfaceVariant
                )
            }
            TextButton(
                onClick = { onTextScaleChange(TEXT_SCALE_DEFAULT) },
                enabled = textScale != TEXT_SCALE_DEFAULT
            ) {
                Text("Сбросить")
            }
        }

        Slider(
            value = textScale.toFloat(),
            onValueChange = { onTextScaleChange((it / 5f).roundToInt() * 5) },
            valueRange = TEXT_SCALE_MIN.toFloat()..TEXT_SCALE_MAX.toFloat(),
            steps = (TEXT_SCALE_MAX - TEXT_SCALE_MIN) / 5 - 1
        )

        Spacer(modifier = Modifier.height(16.dp))

        Text(
            text = "Свой шрифт",
            style = MaterialTheme.typography.titleMedium,
            color = colors.onSurface
        )
        Text(
            text = fontName ?: "Системный",
            style = MaterialTheme.typography.bodySmall,
            color = colors.onSurfaceVariant,
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )

        Spacer(modifier = Modifier.height(12.dp))

        Row(verticalAlignment = Alignment.CenterVertically) {
            FilledTonalButton(onClick = onPickFont) {
                Text("Выбрать файл")
            }
            Spacer(modifier = Modifier.width(8.dp))
            TextButton(onClick = onResetFont, enabled = fontName != null) {
                Text("Сбросить")
            }
        }

        Spacer(modifier = Modifier.height(16.dp))

        Box(
            modifier = Modifier
                .fillMaxWidth()
                .clip(RoundedCornerShape(16.dp))
                .background(colors.surfaceContainerHighest)
                .padding(12.dp)
        ) {
            Text(
                text = "Съешь ещё этих мягких французских булок, да выпей чаю.\nThe quick brown fox 0123456789",
                style = MaterialTheme.typography.bodyLarge,
                color = colors.onSurface
            )
        }

        Spacer(modifier = Modifier.height(8.dp))

        Text(
            text = "Поддерживаются файлы .ttf, .otf и .ttc. Шрифт применяется к интерфейсу приложения и к тексту в X.",
            style = MaterialTheme.typography.bodySmall,
            color = colors.onSurfaceVariant
        )
    }
}
