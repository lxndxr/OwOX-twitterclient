                            offset = DpOffset(0.dp, 12.dp)
                        )
                    )
                    .clip(glassShape)
                    .background(Color.White.copy(alpha = 0.03f), glassShape)
                    .innerShadow(
                        shape = glassShape,
                        shadow = Shadow(
                            radius = 1.dp,
                            color = Color.White.copy(alpha = 0.9f),
                            offset = DpOffset(0.dp, 1.dp)
                        )
                    )
                    .innerShadow(
                        shape = glassShape,
                        shadow = Shadow(
                            radius = 2.dp,
                            color = Color.White.copy(alpha = 0.4f),
                            offset = DpOffset(0.dp, (-1).dp)
                        )
                    )
                    .innerShadow(
                        shape = glassShape,
                        shadow = Shadow(
                            radius = 18.dp,
                            spread = 4.dp,
                            color = Color.White.copy(alpha = 0.35f),
                            offset = DpOffset(0.dp, 0.dp)
                        )
                    )
                    .border(
                        width = 1.dp,
                        color = Color.White.copy(alpha = 0.45f),
                        shape = glassShape
                    )
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(80.dp)
