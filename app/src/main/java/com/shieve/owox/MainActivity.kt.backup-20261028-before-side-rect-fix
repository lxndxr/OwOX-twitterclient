@Composable
fun OwOXRoot() {
    val context = LocalContext.current
    val prefs = remember { context.getSharedPreferences("owox_settings", Context.MODE_PRIVATE) }
    var currentTheme by remember {
        mutableStateOf(AppThemeMode.fromId(prefs.getInt("theme_mode", AppThemeMode.BLACK.id)))
    }
    var accent by remember {
        mutableStateOf(Color(prefs.getInt(PREF_ACCENT, DEFAULT_ACCENT.toArgb())))
    }

    var textScale by remember {
        mutableIntStateOf(
            prefs.getInt(PREF_TEXT_SCALE, TEXT_SCALE_DEFAULT).coerceIn(TEXT_SCALE_MIN, TEXT_SCALE_MAX)
        )
    }
    var customFont by remember { mutableStateOf(loadSavedFont(context, prefs)) }
    var recentAccents by remember { mutableStateOf(loadRecentAccents(prefs)) }

    fun setAccent(color: Color) {
        accent = color
        prefs.edit().putInt(PREF_ACCENT, color.toArgb()).apply()
    }

    // Порядок стабильный: цвет, который уже есть в списке, не двигается, новый встаёт первым.
    // Исходный голубой X не сохраняется: вернуться к нему можно кнопкой «Сбросить».
    fun pushRecent(argb: Int) {
        if (argb == DEFAULT_ACCENT.toArgb() || argb in recentAccents) return
        val updated = (listOf(argb) + recentAccents).take(RECENT_ACCENTS_MAX)
        recentAccents = updated
        prefs.edit().putString(PREF_RECENT_ACCENTS, updated.joinToString(",")).apply()
    }

    // Слайдер даёт десятки промежуточных значений, поэтому цвет считается недавним,
    // только если пользователь задержался на нём больше секунды
    LaunchedEffect(accent) {
        delay(1200)
        pushRecent(accent.toArgb())
    }

    val colorScheme = remember(currentTheme, accent) { currentTheme.toColorScheme(accent) }
    val typography = remember(customFont?.version) {
        val typeface = if (customFont != null) loadTypeface(context) else null
        if (typeface != null) Typography().withFontFamily(FontFamily(typeface)) else Typography()
    }

    val appContext = context.applicationContext
    val importFont: (Uri) -> Unit = { uri ->
        ioExecutor.execute {
            val result = runCatching { importFontFile(appContext, uri) }
            mainHandler.post {
                result.onSuccess { font ->
                    customFont = font
                    prefs.edit()
                        .putLong(PREF_FONT_VERSION, font.version)
                        .putString(PREF_FONT_NAME, font.name)
                        .apply()
                }.onFailure { error ->
                    Toast.makeText(
                        appContext,
                        "Не удалось загрузить шрифт: ${error.message ?: "неподдерживаемый файл"}",
                        Toast.LENGTH_LONG
                    ).show()
                }
            }
        }
    }
    val resetFont: () -> Unit = {
        fontFile(appContext).delete()
        customFont = null
        prefs.edit().remove(PREF_FONT_VERSION).remove(PREF_FONT_NAME).apply()
    }

    MaterialTheme(colorScheme = colorScheme, typography = typography) {
        OwOXApp(
            currentTheme = currentTheme,
            onThemeChange = { newTheme ->
                currentTheme = newTheme
                prefs.edit().putInt("theme_mode", newTheme.id).apply()
            },
            accent = accent,
            onAccentChange = { setAccent(it) },
            recentAccents = recentAccents.map { Color(it) },
            // Выбор из недавних или сброс: текущий цвет сначала сохраняется, чтобы к нему можно было вернуться
            onAccentPick = { color ->
                pushRecent(accent.toArgb())
                setAccent(color)
            },
            textScale = textScale,
            onTextScaleChange = { value ->
                if (value != textScale) {
                    textScale = value
                    prefs.edit().putInt(PREF_TEXT_SCALE, value).apply()
                }
            },
            fontName = customFont?.name,
            fontVersion = customFont?.version ?: 0L,
            onFontImport = importFont,
            onFontReset = resetFont
        )
    }
}

@SuppressLint("SetJavaScriptEnabled")
@Composable
fun OwOXApp(
    currentTheme: AppThemeMode,
    onThemeChange: (AppThemeMode) -> Unit,
    accent: Color,
    onAccentChange: (Color) -> Unit,
    recentAccents: List<Color>,
    onAccentPick: (Color) -> Unit,
    textScale: Int,
    onTextScaleChange: (Int) -> Unit,
    fontName: String?,
    fontVersion: Long,
    onFontImport: (Uri) -> Unit,
    onFontReset: () -> Unit
) {
    val context = LocalContext.current

    var webView by remember { mutableStateOf<WebView?>(null) }
    var canGoBack by remember { mutableStateOf(false) }
    var loadProgress by remember { mutableIntStateOf(0) }
    var notificationBadge by remember { mutableIntStateOf(0) }
    var messageBadge by remember { mutableIntStateOf(0) }
    var saveRequest by remember { mutableStateOf<SaveRequest?>(null) }

    // Вкладка веб-части и экран настроек хранятся отдельно: из настроек
    // можно вернуться ровно туда, где пользователь был.
    var webTab by rememberSaveable { mutableStateOf(0) }
    var showSettings by rememberSaveable { mutableStateOf(false) }

    val fileChooser = remember { FileChooserHolder() }
    val pendingDownload = remember { PendingDownloadHolder() }

    // Клиент WebView создаётся один раз, поэтому актуальную версию шрифта он читает из этого состояния
    val fontVersionState = rememberUpdatedState(fontVersion)

    // «*/*»: системные пикеры плохо знают MIME-типы шрифтов, формат проверяется по содержимому
    val fontPickerLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.OpenDocument()
    ) { uri ->
        if (uri != null) onFontImport(uri)
    }

    // Смена шрифта применяется на открытой странице сразу, без перезагрузки
    LaunchedEffect(fontVersion, webView) {
        webView?.evaluateJavascript(fontScript(fontVersion), null)
    }

    // Цвет акцента для самого X. Применяется с задержкой: слайдер даёт десятки значений в секунду,
    // а перекраска обходит все правила стилей страницы
    val accentState = rememberUpdatedState(accent.toArgb())
    LaunchedEffect(accent, webView) {
        delay(400)
        webView?.evaluateJavascript(accentScript(accent.toArgb()), null)
    }

    // Выбор файлов для вложений в твиты
    val fileChooserLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.StartActivityForResult()
    ) { result ->
        fileChooser.callback?.onReceiveValue(
            WebChromeClient.FileChooserParams.parseResult(result.resultCode, result.data)
        )
        fileChooser.callback = null
    }

    // Разрешение на запись нужно только на Android 9 и ниже
    val storagePermissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestPermission()
    ) { granted ->
        val task = pendingDownload.task
        pendingDownload.task = null
        if (granted && task != null) {
            enqueueDownload(context, task)
        } else {
            Toast.makeText(context, "Нет разрешения на сохранение файлов", Toast.LENGTH_SHORT).show()
        }
    }

    fun startDownload(task: DownloadTask) {
        if (task.probe == null && !task.url.startsWith("http", ignoreCase = true)) {
            Toast.makeText(context, "Этот файл нельзя скачать", Toast.LENGTH_SHORT).show()
            return
        }
        val needsPermission = Build.VERSION.SDK_INT <= Build.VERSION_CODES.P &&
                ContextCompat.checkSelfPermission(context, Manifest.permission.WRITE_EXTERNAL_STORAGE) !=
                PackageManager.PERMISSION_GRANTED
        if (needsPermission) {
            pendingDownload.task = task
            storagePermissionLauncher.launch(Manifest.permission.WRITE_EXTERNAL_STORAGE)
        } else {
            enqueueDownload(context, task)
        }
    }

    fun applyTheme(theme: AppThemeMode) {
        applyThemeCookies(theme)
        webView?.apply {
            setBackgroundColor(theme.webViewColor)
            reload()
        }
    }

    // Пауза WebView вместе с приложением: останавливает таймеры, анимации и звук в фоне
    val lifecycle = (context as? ComponentActivity)?.lifecycle
    DisposableEffect(lifecycle) {
        if (lifecycle == null) return@DisposableEffect onDispose { }
        val observer = LifecycleEventObserver { _, event ->
            when (event) {
                Lifecycle.Event.ON_PAUSE -> webView?.onPause()
                Lifecycle.Event.ON_RESUME -> webView?.onResume()
                else -> Unit
            }
        }
        lifecycle.addObserver(observer)
        onDispose { lifecycle.removeObserver(observer) }
    }

    // Из настроек «Назад» возвращает в ленту, иначе листает историю WebView
    BackHandler(enabled = showSettings || canGoBack) {
        if (showSettings) showSettings = false else webView?.goBack()
    }

    Scaffold(
        containerColor = MaterialTheme.colorScheme.background,
        bottomBar = {
            androidx.compose.ui.window.Dialog(
                onDismissRequest = {},
                properties = DialogProperties(
                    dismissOnBackPress = false,
                    dismissOnClickOutside = false,
                    usePlatformDefaultWidth = false
                )
            ) {
            val dialogContentView = LocalView.current
            val density = LocalDensity.current
            DisposableEffect(dialogContentView, density) {
                fun applyGlassWindow() {
                    val windowProvider = (dialogContentView.parent as? DialogWindowProvider)
                        ?: (dialogContentView as? DialogWindowProvider)
                    val window = windowProvider?.window ?: return
                    window.apply {
                        setBackgroundDrawable(
                            InsetDrawable(
                                GradientDrawable().apply {
                                    shape = GradientDrawable.RECTANGLE
                                    cornerRadius = with(density) { 40.dp.toPx() }
                                    setColor(android.graphics.Color.argb(13, 255, 255, 255))
                                },
                                with(density) { 14.dp.roundToPx() },
                                with(density) { 8.dp.roundToPx() },
                                with(density) { 14.dp.roundToPx() },
                                0
                            )
                        )
                        clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
                        setDimAmount(0f)
                        addFlags(WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL)
                        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                            setBackgroundBlurRadius(with(density) { 24.dp.roundToPx() })
                        }
                        attributes = attributes.apply {
                            gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
                            y = 0
                            dimAmount = 0f
                        }
                    }
                }

                val attachListener = object : View.OnAttachStateChangeListener {
                    override fun onViewAttachedToWindow(view: View) {
                        view.post { applyGlassWindow() }
                    }

                    override fun onViewDetachedFromWindow(view: View) = Unit
                }
                dialogContentView.addOnAttachStateChangeListener(attachListener)
                if (dialogContentView.isAttachedToWindow) {
                    dialogContentView.post { applyGlassWindow() }
                }
                onDispose {
                    dialogContentView.removeOnAttachStateChangeListener(attachListener)
