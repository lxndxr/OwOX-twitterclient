                ) {
                    Box(
                        modifier = Modifier
                            .size(width = 56.dp, height = 32.dp)
                            .then(
                                if (showSettings) {
                                    Modifier
                                        .dropShadow(
                                            shape = CircleShape,
                                            shadow = Shadow(
                                                radius = 12.dp,
                                                color = Color.Black.copy(alpha = 0.12f),
