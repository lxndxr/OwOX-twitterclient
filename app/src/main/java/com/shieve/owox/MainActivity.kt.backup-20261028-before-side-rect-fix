                for (var j = 0; j < spans.length; j++) {
                    var span = spans[j];
                    if (AD_LABELS[span.textContent.trim()] === 1 && !span.closest(SKIP)) {
                        article.style.display = 'none';
                        break;
                    }
                }
            }
        }

        function schedule() {
            if (!scheduled) {
                scheduled = true;
                requestAnimationFrame(clean);
            }
        }

        // X может заменить head при старте SPA. Следим за DOM и возвращаем свои стили,
        // если сайт удалил их или пересоздал документную оболочку.
        new MutationObserver(function () {
            ensureStyle();
            schedule();
        }).observe(root, { childList: true, subtree: true });
        schedule();

        // 3. Счётчики непрочитанного: читаем бейджи на ссылках нативной панели X
        //    (она скрыта стилем выше, но остаётся в DOM и обновляется) и передаём в приложение.
        function parseCount(text) {
            var m = /(\d{1,3})(\+?)/.exec(text || '');
            if (!m) return 0;
            return m[2] ? 100 : parseInt(m[1], 10);
        }

        // -1: ссылки на странице нет, значение в приложении менять не нужно
        function readBadge(hrefs) {
            var link = null;
            for (var i = 0; i < hrefs.length && !link; i++) {
                link = document.querySelector('a[href="' + hrefs[i] + '"]');
            }
            if (!link) return -1;
            var fromLabel = parseCount(link.getAttribute('aria-label'));
            if (fromLabel) return fromLabel;
            var live = link.querySelector('[aria-live]');
            if (live) return parseCount(live.textContent);
            var spans = link.querySelectorAll('span');
            for (var j = 0; j < spans.length; j++) {
                var t = spans[j].textContent.trim();
                var d = /^(\d{1,3})(\+?)/.exec(t);
                if (d && d[0] === t) return parseCount(t);
            }
            return 0;
        }

        var lastReport = '';
        function report() {
            var n = readBadge(['/notifications']);
            var m = readBadge(['/messages', '/i/chat']);
            if (n < 0 && m < 0) return;
            var key = n + ':' + m;
            if (key === lastReport) return;
            lastReport = key;
            if (window.OwOXNative) window.OwOXNative.onBadges(n, m);
        }

        setInterval(report, 2000);
        report();
    })();
""".trimIndent()

/**
 * Определяет, есть ли видео под пальцем (координаты в CSS-пикселях), и возвращает JSON
 * с адресом ролика, id твита и токеном для embed-API X. Пустая строка: видео нет.
 */
private fun mediaProbeScript(x: Float, y: Float): String = """
    (function (x, y) {
        var el = document.elementFromPoint(x, y);
        var article = el ? el.closest('article') : null;
        var scope = article || document;
        var videos = scope.querySelectorAll('video');
        var target = null;
        for (var i = 0; i < videos.length; i++) {
            var r = videos[i].getBoundingClientRect();
            if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) {
                target = videos[i];
                break;
            }
        }
        if (!target) return '';
        var id = '';
        var holder = target.closest('article');
        var time = holder ? holder.querySelector('a[href*="/status/"] time') : null;
        var href = time ? time.closest('a').getAttribute('href') : location.pathname;
        var m = /\/status\/(\d+)/.exec(href || '');
        if (m) id = m[1];
        var token = id ? ((Number(id) / 1e15) * Math.PI).toString(36).replace(/(0+|\.)/g, '') : '';
        return JSON.stringify({ src: target.currentSrc || target.src || '', id: id, token: token });
    })($x, $y);
""".trimIndent()

