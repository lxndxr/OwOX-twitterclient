/** Виртуальный адрес шрифта внутри страниц X: запрос перехватывается и отдаётся из файла (см. shouldInterceptRequest). */
private const val FONT_URL_PATH = "/__owox_font"
private const val FONT_MAX_BYTES = 25L * 1024 * 1024

private data class CustomFont(val name: String, val version: Long)

/** Единственная копия выбранного шрифта во внутреннем хранилище приложения. */
private fun fontFile(context: Context) = File(context.filesDir, "custom_font.bin")

private fun loadSavedFont(context: Context, prefs: android.content.SharedPreferences): CustomFont? {
    val version = prefs.getLong(PREF_FONT_VERSION, 0L)
    val name = prefs.getString(PREF_FONT_NAME, null)
    return if (version > 0 && name != null && fontFile(context).exists()) CustomFont(name, version) else null
}

private fun loadTypeface(context: Context): Typeface? =
    runCatching { Typeface.createFromFile(fontFile(context)) }.getOrNull()

/** TrueType (0x00010000, «true»), OpenType («OTTO») или коллекция («ttcf»). WOFF Android не поддерживает. */
private fun hasFontSignature(file: File): Boolean {
    val head = ByteArray(4)
    file.inputStream().use { if (it.read(head) < 4) return false }
    val tag = String(head, Charsets.ISO_8859_1)
    val isTrueType = head[0] == 0.toByte() && head[1] == 1.toByte() && head[2] == 0.toByte() && head[3] == 0.toByte()
    return isTrueType || tag == "OTTO" || tag == "true" || tag == "ttcf"
}

private fun displayName(resolver: ContentResolver, uri: Uri): String {
    val raw = runCatching {
        resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
            if (cursor.moveToFirst()) cursor.getString(0) else null
        }
    }.getOrNull()
    return (raw ?: uri.lastPathSegment ?: "Свой шрифт").substringBeforeLast('.')
}

/**
 * Копирует выбранный файл во внутреннее хранилище (доступ к исходному файлу после этого не нужен),
 * проверяет сигнатуру и пробной загрузкой убеждается, что шрифт читается. Выполняется в фоновом потоке.
 */
private fun importFontFile(context: Context, uri: Uri): CustomFont {
    val resolver = context.contentResolver
    val tmp = File(context.filesDir, "custom_font.tmp")
    try {
        var total = 0L
        resolver.openInputStream(uri)?.use { input ->
            tmp.outputStream().use { output ->
                val buffer = ByteArray(16 * 1024)
                while (true) {
                    val read = input.read(buffer)
                    if (read < 0) break
                    total += read
                    if (total > FONT_MAX_BYTES) throw IOException("файл больше 25 МБ")
                    output.write(buffer, 0, read)
                }
            }
        } ?: throw IOException("не удалось открыть файл")

        if (!hasFontSignature(tmp)) throw IOException("нужен файл .ttf, .otf или .ttc")
        val typeface = try {
            Typeface.createFromFile(tmp)
        } catch (_: Exception) {
            null
        }
        if (typeface == null) throw IOException("шрифт повреждён")

        val target = fontFile(context)
        if (target.exists()) target.delete()
        if (!tmp.renameTo(target)) throw IOException("не удалось сохранить шрифт")
        return CustomFont(displayName(resolver, uri), System.currentTimeMillis())
    } finally {
        if (tmp.exists()) tmp.delete()
    }
}

/**
 * Подменяет шрифт на страницах X: @font-face с виртуальным адресом + правило для всех элементов.
 * Версия в адресе сбрасывает кэш при смене файла. version = 0 убирает подмену.
 * Скрипт идемпотентен: старый <style> заменяется, поэтому смена шрифта применяется без перезагрузки.
 */
private fun fontScript(version: Long): String {
    val css = if (version > 0) {
        """@font-face{font-family:"OwOXFont";src:url("$FONT_URL_PATH?v=$version");font-display:swap;}""" +
                """body,body *{font-family:"OwOXFont",sans-serif !important;}"""
    } else {
        ""
    }
    return """
        (function () {
            var host = location.hostname;
            var isX = host === 'x.com' || host === 'twitter.com' ||
                host.endsWith('.x.com') || host.endsWith('.twitter.com');
            if (!isX) return;
            var old = document.getElementById('owox-font');
            if (old) old.remove();
            var css = '$css';
            if (!css) return;
            var style = document.createElement('style');
            style.id = 'owox-font';
            style.textContent = css;
            (document.head || document.documentElement).appendChild(style);
        })();
    """.trimIndent()
}

/** Один и тот же шрифт для всех 15 стилей Material 3, чтобы он применился ко всему интерфейсу. */
private fun Typography.withFontFamily(family: FontFamily) = copy(
    displayLarge = displayLarge.copy(fontFamily = family),
    displayMedium = displayMedium.copy(fontFamily = family),
    displaySmall = displaySmall.copy(fontFamily = family),
    headlineLarge = headlineLarge.copy(fontFamily = family),
    headlineMedium = headlineMedium.copy(fontFamily = family),
    headlineSmall = headlineSmall.copy(fontFamily = family),
    titleLarge = titleLarge.copy(fontFamily = family),
    titleMedium = titleMedium.copy(fontFamily = family),
    titleSmall = titleSmall.copy(fontFamily = family),
    bodyLarge = bodyLarge.copy(fontFamily = family),
    bodyMedium = bodyMedium.copy(fontFamily = family),
    bodySmall = bodySmall.copy(fontFamily = family),
    labelLarge = labelLarge.copy(fontFamily = family),
    labelMedium = labelMedium.copy(fontFamily = family),
    labelSmall = labelSmall.copy(fontFamily = family)
)

