/**
 * Полная цветовая схема Material 3: основа задаётся темой X, а все акцентные роли
 * (primary, контейнеры, индикатор навигации) выводятся из выбранного цвета акцента.
 */
private fun AppThemeMode.toColorScheme(accent: Color): ColorScheme {
    val base = when (this) {
        AppThemeMode.BLACK -> darkColorScheme(
            primary = DEFAULT_ACCENT,
            background = Color(0xFF000000),
            onBackground = Color(0xFFE7E9EA),
            surface = Color(0xFF000000),
            onSurface = Color(0xFFE7E9EA),
            surfaceVariant = Color(0xFF16181C),
            onSurfaceVariant = Color(0xFF8A9096),
            surfaceDim = Color(0xFF000000),
            surfaceBright = Color(0xFF2A2D31),
            surfaceContainerLowest = Color(0xFF000000),
            surfaceContainerLow = Color(0xFF0A0C0E),
            surfaceContainer = Color(0xFF111316),
            surfaceContainerHigh = Color(0xFF181B1F),
            surfaceContainerHighest = Color(0xFF20242A),
            outline = Color(0xFF5B6168),
            outlineVariant = Color(0xFF2F3336)
        )

        AppThemeMode.WHITE -> lightColorScheme(
            primary = DEFAULT_ACCENT,
            background = Color(0xFFFFFFFF),
            onBackground = Color(0xFF0F1419),
            surface = Color(0xFFFFFFFF),
            onSurface = Color(0xFF0F1419),
            surfaceVariant = Color(0xFFF7F9F9),
            onSurfaceVariant = Color(0xFF536471),
            surfaceDim = Color(0xFFE3E7EA),
            surfaceBright = Color(0xFFFFFFFF),
            surfaceContainerLowest = Color(0xFFFFFFFF),
            surfaceContainerLow = Color(0xFFF8FAFB),
            surfaceContainer = Color(0xFFF1F4F6),
            surfaceContainerHigh = Color(0xFFEBEFF2),
            surfaceContainerHighest = Color(0xFFE4E9EC),
            outline = Color(0xFF75828C),
            outlineVariant = Color(0xFFCFD9DE)
        )
    }

    // Цвет текста/иконок поверх акцента: чёрный на светлом акценте, белый на тёмном
    val onAccent = if (accent.luminance() > 0.45f) Color.Black else Color.White

    return if (isDark) {
        base.copy(
            primary = accent,
            onPrimary = onAccent,
            primaryContainer = lerp(base.surface, accent, 0.32f),
            onPrimaryContainer = lerp(accent, Color.White, 0.80f),
            secondary = lerp(accent, base.onSurfaceVariant, 0.45f),
            secondaryContainer = lerp(base.surface, accent, 0.26f),
            onSecondaryContainer = lerp(accent, Color.White, 0.85f),
            surfaceTint = accent
        )
    } else {
        base.copy(
            primary = accent,
            onPrimary = onAccent,
            primaryContainer = lerp(base.surface, accent, 0.22f),
            onPrimaryContainer = lerp(accent, Color.Black, 0.65f),
            secondary = lerp(accent, base.onSurfaceVariant, 0.45f),
            secondaryContainer = lerp(base.surface, accent, 0.18f),
            onSecondaryContainer = lerp(accent, Color.Black, 0.70f),
            surfaceTint = accent
        )
    }
}

/** Применяет куку темы X. Страница подхватит её при следующей загрузке/перезагрузке. */
private fun applyThemeCookies(theme: AppThemeMode) {
    val cookieManager = CookieManager.getInstance()
    cookieManager.setAcceptCookie(true)
    for (domain in X_DOMAINS) {
        cookieManager.setCookie(
            "https://$domain",
            "night_mode=${theme.cookieValue}; domain=.$domain; path=/; max-age=31536000; Secure; SameSite=None"
        )
    }
    cookieManager.flush()
}

