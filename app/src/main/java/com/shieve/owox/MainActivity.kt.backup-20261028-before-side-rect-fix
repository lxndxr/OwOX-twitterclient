                    ) {
                        Box(
                            modifier = Modifier
                                .size(width = 56.dp, height = 32.dp)
                                .then(
                                    if (selected) {
                                        Modifier
                                            .dropShadow(
                                                shape = CircleShape,
                                                shadow = Shadow(
                                                    radius = 12.dp,
                                                    color = Color.Black.copy(alpha = 0.12f),
                                                    offset = DpOffset(0.dp, 4.dp)
                                                )
                                            )
                                            .clip(CircleShape)
                                            .background(Color.White.copy(alpha = 0.35f), CircleShape)
                                            .innerShadow(
                                                shape = CircleShape,
                                                shadow = Shadow(
                                                    radius = 2.dp,
                                                    color = Color.White.copy(alpha = 0.9f),
