                )
                .consumeWindowInsets(innerPadding)
                .background(MaterialTheme.colorScheme.background)
        ) {
            // WebView всегда живёт в фоне, чтобы не терять позицию скролла при заходе в настройки
            Column(modifier = Modifier.fillMaxSize()) {
                LoadProgressBar(progress = { loadProgress }, visible = !showSettings)

                AndroidView(
                    modifier = Modifier.fillMaxSize(),
                    factory = { ctx ->
                        applyThemeCookies(currentTheme)

                        WebView(ctx).apply {
                            layoutParams = ViewGroup.LayoutParams(
                                ViewGroup.LayoutParams.MATCH_PARENT,
                                ViewGroup.LayoutParams.MATCH_PARENT
                            )
                            setBackgroundColor(currentTheme.webViewColor)
                            CookieManager.getInstance().setAcceptThirdPartyCookies(this, true)

                            settings.apply {
                                javaScriptEnabled = true
                                domStorageEnabled = true
                                useWideViewPort = true
                                loadWithOverviewMode = true
                                mediaPlaybackRequiresUserGesture = false
                                javaScriptCanOpenWindowsAutomatically = true
                                setSupportMultipleWindows(true)
                                userAgentString = CHROME_UA
                                textZoom = textScale
                            }

                            // Счётчики непрочитанного приходят из страницы (см. CORE_SCRIPT)
                            addJavascriptInterface(
                                OwOXBridge { notifications, messages ->
                                    if (notifications >= 0) notificationBadge = notifications
                                    if (messages >= 0) messageBadge = messages
                                },
                                "OwOXNative"
                            )

                            webChromeClient = object : WebChromeClient() {
                                override fun onProgressChanged(view: WebView?, newProgress: Int) {
                                    loadProgress = newProgress
                                }

                                override fun onShowFileChooser(
                                    view: WebView?,
                                    callback: ValueCallback<Array<Uri>>?,
                                    params: FileChooserParams?
                                ): Boolean {
                                    if (callback == null || params == null) return false
                                    // Предыдущий незавершённый запрос нужно обязательно закрыть
                                    fileChooser.callback?.onReceiveValue(null)
                                    fileChooser.callback = callback
                                    try {
                                        fileChooserLauncher.launch(params.createIntent())
                                    } catch (_: Exception) {
                                        fileChooser.callback = null
                                        callback.onReceiveValue(null)
                                    }
                                    return true
                                }

                                override fun onCreateWindow(
                                    view: WebView?,
                                    isDialog: Boolean,
                                    isUserGesture: Boolean,
                                    resultMsg: Message?
                                ): Boolean {
                                    val msg = resultMsg ?: return false
                                    val transport = msg.obj as? WebView.WebViewTransport ?: return false

                                    val dialog = Dialog(ctx, android.R.style.Theme_Black_NoTitleBar_Fullscreen)
                                    val popupWebView = WebView(ctx).apply {
                                        settings.apply {
                                            javaScriptEnabled = true
                                            domStorageEnabled = true
                                            javaScriptCanOpenWindowsAutomatically = true
                                            setSupportMultipleWindows(true)
                                            userAgentString = CHROME_UA
                                        }
                                        CookieManager.getInstance().setAcceptThirdPartyCookies(this, true)
                                        webViewClient = WebViewClient()
                                        webChromeClient = object : WebChromeClient() {
                                            override fun onCloseWindow(window: WebView?) {
                                                dialog.dismiss() // WebView уничтожится в OnDismissListener
                                            }
                                        }
                                    }

                                    dialog.setContentView(popupWebView)
                                    dialog.setOnDismissListener { popupWebView.destroy() }
                                    dialog.show()

                                    transport.webView = popupWebView
                                    msg.sendToTarget()
                                    return true
                                }
                            }

                            webViewClient = object : WebViewClient() {
                                override fun onPageStarted(view: WebView, url: String?, favicon: Bitmap?) {
                                    super.onPageStarted(view, url, favicon)
                                    view.evaluateJavascript(CORE_SCRIPT, null)
                                    view.evaluateJavascript(fontScript(fontVersionState.value), null)
                                    view.evaluateJavascript(accentScript(accentState.value), null)
                                }

                                override fun onPageFinished(view: WebView, url: String?) {
                                    super.onPageFinished(view, url)
                                    view.evaluateJavascript(CORE_SCRIPT, null)
                                    view.evaluateJavascript(fontScript(fontVersionState.value), null)
                                    view.evaluateJavascript(accentScript(accentState.value), null)
                                    CookieManager.getInstance().flush()
                                }

                                // Отдаём страницам X выбранный шрифт по виртуальному адресу.
                                // Для остальных сайтов запрос не перехватывается.
                                override fun shouldInterceptRequest(
                                    view: WebView,
                                    request: WebResourceRequest
                                ): WebResourceResponse? {
                                    val uri = request.url
                                    if (uri.path != FONT_URL_PATH || !hostIn(uri.host, X_DOMAINS)) return null
                                    val file = fontFile(ctx)
                                    if (!file.exists()) return null
                                    return try {
                                        WebResourceResponse(
                                            "font/ttf", null, 200, "OK",
                                            mapOf(
                                                "Access-Control-Allow-Origin" to "*",
                                                "Cache-Control" to "no-store"
                                            ),
                                            FileInputStream(file)
                                        )
                                    } catch (_: IOException) {
                                        null
                                    }
                                }

                                // Срабатывает и при SPA-навигации (pushState), поэтому здесь
                                // же синхронизируем кнопку «Назад» и подсветку вкладки
                                override fun doUpdateVisitedHistory(view: WebView, url: String?, isReload: Boolean) {
                                    super.doUpdateVisitedHistory(view, url, isReload)
                                    canGoBack = view.canGoBack()
                                    tabForUrl(url)?.let { webTab = it }
                                }

                                override fun shouldOverrideUrlLoading(
                                    view: WebView,
                                    request: WebResourceRequest
                                ): Boolean {
                                    if (!request.isForMainFrame) return false
                                    val uri = request.url
                                    val scheme = uri.scheme?.lowercase()
                                    val isWeb = scheme == "http" || scheme == "https"
                                    return when {
                                        isWeb && isInternalUri(uri) -> false
                                        !isWeb && scheme in LOCAL_SCHEMES -> false
                                        else -> {
                                            openExternally(ctx, uri)
                                            true
                                        }
                                    }
                                }
                            }

                            // Обычные скачивания
                            setDownloadListener { url, _, contentDisposition, mimeType, _ ->
                                startDownload(
                                    DownloadTask(
                                        url = url,
                                        fileName = URLUtil.guessFileName(url, contentDisposition, mimeType),
                                        mimeType = mimeType?.takeIf { it.isNotBlank() } ?: "application/octet-stream"
                                    )
                                )
                            }

                            // Запоминаем точку касания: по ней при долгом нажатии ищем видео
                            var lastTouchX = 0f
                            var lastTouchY = 0f
                            setOnTouchListener { _, event ->
                                if (event.actionMasked == MotionEvent.ACTION_DOWN) {
                                    lastTouchX = event.x
                                    lastTouchY = event.y
                                }
                                false
                            }

                            // Долгое нажатие на видео, GIF или картинку: сохранить в галерею
                            setOnLongClickListener { v ->
                                val webViewRef = v as WebView
                                val hit = webViewRef.hitTestResult
                                val imageUrl = hit.extra?.takeIf {
                                    hit.type == WebView.HitTestResult.IMAGE_TYPE ||
                                            hit.type == WebView.HitTestResult.SRC_IMAGE_ANCHOR_TYPE
                                }
                                val density = ctx.resources.displayMetrics.density
                                val probeScript = mediaProbeScript(lastTouchX / density, lastTouchY / density)

                                webViewRef.evaluateJavascript(probeScript) { raw ->
                                    val probe = parseVideoProbe(raw)
                                    if (probe != null) {
                                        val label = if (isGifProbe(probe)) "Сохранить GIF" else "Сохранить видео"
                                        saveRequest = SaveRequest(label) { startDownload(videoDownloadTask(probe)) }
                                    } else if (imageUrl != null) {
                                        saveRequest = SaveRequest("Сохранить изображение") {
                                            startDownload(imageDownloadTask(imageUrl))
                                        }
                                    }
                                }
                                // Нажатие поглощаем только на картинках; в остальных местах
                                // остаётся стандартное поведение (например, выделение текста)
                                imageUrl != null
                            }

                            loadUrl(X_HOME_URL)
                            webView = this
                        }
                    },
                    update = { view ->
                        view.visibility = if (showSettings) View.GONE else View.VISIBLE
                        if (view.settings.textZoom != textScale) view.settings.textZoom = textScale
                    },
                    onRelease = { view ->
                        webView = null
                        view.destroy()
                    }
                )
            }

            if (showSettings) {
                OwOXSettingsScreen(
                    currentTheme = currentTheme,
                    onSelectTheme = { newTheme ->
                        onThemeChange(newTheme)
                        applyTheme(newTheme)
                    },
                    accent = accent,
                    onAccentChange = onAccentChange,
                    recentAccents = recentAccents,
                    onAccentPick = onAccentPick,
                    textScale = textScale,
                    onTextScaleChange = onTextScaleChange,
                    fontName = fontName,
                    onPickFont = { fontPickerLauncher.launch(arrayOf("*/*")) },
                    onResetFont = onFontReset
                )
            }
        }
    }

    saveRequest?.let { request ->
        SaveMediaSheet(request = request, onDismiss = { saveRequest = null })
    }
}

@Composable
private fun NavLabel(text: String) {
    Text(
        text = text,
        style = MaterialTheme.typography.labelSmall,
        color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.9f),
        maxLines = 1,
        overflow = TextOverflow.Ellipsis
